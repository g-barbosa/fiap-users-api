{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "FiapCloudGames.Infrastructure.Data.Persistence.Repositories": "Information",
      "FiapCloudGames.Api.Controllers": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=127.0.0.1,1433;Initial Catalog=FiapCloudGamesDb;User ID=SA;Password=Mysql2022!;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "minha-chave-jwt-super-secreta-2026-api-segura",
    "Issuer": "FiapCloudGames",
    "Audience": "FiapCloudGames",
    "ExpiracaoMinutos": 60
    },
    "Serilog": {
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "System": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/fiapcloudgames-.log",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 7,
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
          }
        }
      ],
      "Enrich": [
        "FromLogContext",
        "WithMachineName",
        "WithEnvironmentUserName"
      ],
      "Properties": {
        "Application": "FiapCloudGames",
        "Environment": "Development"
      }
    }
  }
